# API base URL used by the frontend API client.
# Defaults are defined by src/lib/config.ts when unset.
# Copy this file to .env.local and adjust if the API is hosted elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:5000

NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_PROJECT_DETAIL_PREVIEW_SIZE=5
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_QUERY_STALE_TIME=30000
NEXT_PUBLIC_FEATURE_ARABIC=false

# Firebase Web Push (public configuration only; never put a service-account key here)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexus-pmo-36fbf
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

