VITE_API_URL=http://localhost:5000
# Optional tenant selection for environments that expose more than one tenant.
VITE_TENANT_ID=

# Environment-variable mapping (Next.js → Vite). Browser-safe public values only.
# NEXT_PUBLIC_API_URL → VITE_API_URL
# NEXT_PUBLIC_DEFAULT_PAGE_SIZE → VITE_DEFAULT_PAGE_SIZE
# NEXT_PUBLIC_PROJECT_DETAIL_PREVIEW_SIZE → VITE_PROJECT_DETAIL_PREVIEW_SIZE
# NEXT_PUBLIC_DEFAULT_LOCALE → VITE_DEFAULT_LOCALE
# NEXT_PUBLIC_QUERY_STALE_TIME → VITE_QUERY_STALE_TIME
# NEXT_PUBLIC_FEATURE_ARABIC → VITE_FEATURE_ARABIC
# NEXT_PUBLIC_FIREBASE_* → VITE_FIREBASE_*
# Never expose backend secrets (service-account keys, connection strings) with a VITE_ prefix.
VITE_DEFAULT_PAGE_SIZE=20
VITE_PROJECT_DETAIL_PREVIEW_SIZE=5
VITE_DEFAULT_LOCALE=en
VITE_QUERY_STALE_TIME=30000
VITE_FEATURE_ARABIC=true

# Firebase Web Push (public configuration only; never put a service-account key here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=nexus-pmo-36fbf
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
