{
  "Storage": {
    "DocumentsRoot": "./uploads/documents"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NexusPmo;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "NEXUS",
    "Audience": "NEXUS-API",
    "ExpiryHours": 8,
    "RefreshTokenLifetimeDays": 7
  },
  "Security": {
    "LocalPasswords": {
      "TemporaryPasswordExpiryHours": 24,
      "MinimumLength": 12,
      "MaximumLength": 128
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "NEXUS"
  },
  "Firebase": {
    "ProjectId": "nexus-pmo-36fbf",
    "CredentialsPath": "",
    "CredentialsJson": "",
    "AllowApplicationDefaultCredentials": false
  },
  "NotificationDelivery": {
    "BatchSize": 20,
    "MaxAttempts": 5,
    "InitialRetryDelay": "00:01:00",
    "MaxRetryDelay": "01:00:00",
    "PollInterval": "00:00:15",
    "ProcessingLease": "00:02:00",
    "SendTimeout": "00:00:30"
  },
  "TimeTracking": {
    "IdleMinutes": 15,
    "HeartbeatSeconds": 30
  },
  "WorkItemAttachments": {
    "MaximumFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "application/zip",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "image/jpeg",
      "image/png",
      "image/gif",
      "text/plain",
      "text/csv"
    ]
  }
}
