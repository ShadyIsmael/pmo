{
  "Security": {
    "LocalPasswords": {
      "DevelopmentAdminTemporaryPasswordBypassEnabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4000",
      "http://127.0.0.1:4000",
      "https://localhost:4100"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:localhost,1433;Database=NexusPmo;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "NEXUS",
    "Audience": "NEXUS-API",
    "ExpiryHours": 8,
    "RefreshTokenLifetimeDays": 7
  },
  "TimeTracking": {
    "IdleMinutes": 15,
    "HeartbeatSeconds": 30
  },
  "Organization": {
    "StandardWorkingCalendar": {
      "Enabled": true,
      "TenantId": "11111111-1111-1111-1111-111111111111",
      "Name": "Standard",
      "Description": "Development tenant standard: Sunday through Thursday, 08:00-17:00 with a 12:00-13:00 break.",
      "Days": [
        { "DayOfWeek": "Sunday", "IsWorkingDay": true, "StartTime": "08:00", "EndTime": "17:00", "BreakStartTime": "12:00", "BreakEndTime": "13:00" },
        { "DayOfWeek": "Monday", "IsWorkingDay": true, "StartTime": "08:00", "EndTime": "17:00", "BreakStartTime": "12:00", "BreakEndTime": "13:00" },
        { "DayOfWeek": "Tuesday", "IsWorkingDay": true, "StartTime": "08:00", "EndTime": "17:00", "BreakStartTime": "12:00", "BreakEndTime": "13:00" },
        { "DayOfWeek": "Wednesday", "IsWorkingDay": true, "StartTime": "08:00", "EndTime": "17:00", "BreakStartTime": "12:00", "BreakEndTime": "13:00" },
        { "DayOfWeek": "Thursday", "IsWorkingDay": true, "StartTime": "08:00", "EndTime": "17:00", "BreakStartTime": "12:00", "BreakEndTime": "13:00" },
        { "DayOfWeek": "Friday", "IsWorkingDay": false },
        { "DayOfWeek": "Saturday", "IsWorkingDay": false }
      ],
      "Holidays": []
    }
  }
}
