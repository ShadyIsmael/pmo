# Copy this file to `.env` in the repository root and fill in local values.
# `.env` is git-ignored. Never commit real secrets, and never reuse production
# credentials in a development environment.

# --- SQL Server (docker-compose) -------------------------------------------
# Required by docker-compose.yml. SQL Server enforces its own complexity rules
# (at least 8 characters, upper/lower/digit/symbol). The container port is
# published on 127.0.0.1 only.
NEXUS_DB_PASSWORD=

# --- JWT signing key -------------------------------------------------------
# Required whenever ASPNETCORE_ENVIRONMENT is anything other than Development:
# the API and worker refuse to start without it. Development generates a random
# process-local key when this is empty, so locally issued tokens do not survive
# a restart. Generate a value with: openssl rand -base64 48
NEXUS_JWT_SECRET=

# --- Redis (docker-compose) ------------------------------------------------
# Optional. When set, the Redis container requires AUTH with this password.
# Leave empty for a loopback-only, unauthenticated local cache.
NEXUS_REDIS_PASSWORD=

# --- Compose environment ---------------------------------------------------
# docker-compose.override.yml already sets Development for the local stack.
# Set this only when running the base file without the override.
# ASPNETCORE_ENVIRONMENT=Development

# --- Firebase web configuration (frontends) --------------------------------
# Values are baked into the browser bundle and are not secrets, but keep
# environment-specific values out of source control.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
